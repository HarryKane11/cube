{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cube",
  "version": "0.1.2",
  "identifier": "app.cube.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cube",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/CubeSpaces/**",
          "$HOME/CubeSpaces/.preview/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQzg4NUI4MjQ2Mzc1QTMKUldTamRXTWt1SVhJL1psSmdBQnVXamRyM1BTTXVMSkp4TDE2V2kwbG91YzBLUWNGTGVyVXlkTm0K",
      "endpoints": [
        "https://github.com/HarryKane11/cube/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "cube"
        ]
      }
    }
  }
}
